<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>Directory — Thikana Dhabla Ghosi</title>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  * { box-sizing: border-box; }
  body { font-family: Georgia, serif; background: #F2E8D5; color: #2A2118; margin: 0; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 20px; }
  h1 { color: #5C1717; text-align: center; font-size: 2rem; margin-bottom: 8px; }
  .subtitle { text-align: center; color: #7A1F1F; font-size: 1.1rem; margin-bottom: 24px; }
  .notice { background: #fff3cd; border-left: 4px solid #C99A3A; padding: 14px; margin: 20px 0; border-radius: 4px; line-height: 1.6; font-size: 0.95rem; }
  .card { background: #fff; border: 1px solid #d6c39a; border-radius: 8px; padding: 16px; margin: 10px 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .card .info strong { color: #5C1717; font-size: 1.05rem; }
  .card .info small { color: #7A6A55; }
  .card .right { display: flex; gap: 10px; align-items: center; }
  .card .phone { font-family: monospace; color: #5C1717; font-size: 1rem; min-width: 170px; text-align: right; }
  button { background: #5C1717; color: #E8C166; border: none; padding: 10px 18px; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: 0.95rem; transition: background 0.2s; }
  button:hover:not(:disabled) { background: #9B2D2D; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .reveal-btn { background: #C99A3A; color: #1C0F0A; }
  .reveal-btn:hover:not(:disabled) { background: #E8C166; }
  #captchaBox { display: none; text-align: center; padding: 24px; background: #fff; border: 2px solid #C99A3A; border-radius: 8px; margin: 20px 0; }
  #search { width: 100%; padding: 12px; border: 2px solid #C99A3A; border-radius: 6px; font-size: 1rem; font-family: inherit; }
  #status { text-align: center; color: #7A1F1F; margin: 12px 0; min-height: 22px; font-weight: 600; }
  .counter { text-align: center; font-size: 0.9rem; color: #7A1F1F; margin-bottom: 12px; background: #fff3cd; padding: 10px; border-radius: 4px; }
  .back { display: inline-block; margin-bottom: 16px; color: #5C1717; text-decoration: none; font-size: 0.9rem; }
  .back:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="wrap">
  <a href="index.html" class="back">← Back to Home</a>
  <h1>॥ राघवाय नमः ॥</h1>
  <p class="subtitle">Thikana Dhabla Ghosi — Family Contact Directory</p>

  <div class="notice">
    <strong>🔒 Privacy Notice:</strong> Phone numbers are protected.
    Verify you are human to reveal numbers (5 at a time, 15 total per session).
    Your IP, approximate location, and access time are logged.
  </div>

  <input type="text" id="search" placeholder="🔍 Search by name..." oninput="render()">

  <div id="captchaBox">
    <p style="margin-bottom: 14px;"><strong>Please complete verification to continue:</strong></p>
    <div class="cf-turnstile"
         data-sitekey="0x4AAAAAAE6FfzKH0NJKU_fE"
         data-callback="onCaptchaSuccess"
         data-theme="light"></div>
  </div>

  <div id="status"></div>
  <div id="counter" class="counter" style="display:none;"></div>
  <div id="list">Loading directory...</div>
</div>

<script>
const SUPABASE_URL = "https://fmrmiylqjokyrsztfmgp.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_cNHjqBdWpu98niKZqMvIuA_96VjEQxk";
const FN_URL = `${SUPABASE_URL}/functions/v1`;

const BATCH_SIZE = 5;
const MAX_VIEWS = 15;

const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let sessionId = null;
let viewsRemaining = MAX_VIEWS;
let allContacts = [];
let revealedSet = new Set();
let selectedIds = new Set();
let needsCaptcha = true;

async function loadList() {
  const { data, error } = await sb
    .from("contacts")
    .select("id, name, relation, city")
    .order("id");

  if (error) {
    document.getElementById("list").textContent = "Error: " + error.message;
    return;
  }
  allContacts = data;
  render();
  showCaptcha();
}

function render() {
  const q = document.getElementById("search").value.toLowerCase();
  const filtered = allContacts.filter(c => c.name.toLowerCase().includes(q));

  document.getElementById("list").innerHTML = filtered.map(c => `
    <div class="card">
      <div class="info">
        <strong>${esc(c.name)}</strong><br>
        <small>${esc(c.relation || '')} ${c.city ? '· ' + esc(c.city) : ''}</small>
      </div>
      <div class="right">
        <span class="phone" id="phone-${c.id}">
          ${revealedSet.has(c.id) ? '' : '+91 ••••• •••••'}
        </span>
        ${revealedSet.has(c.id) ? '<span style="color:#138808;font-weight:bold;">✓</span>' :
          `<button class="reveal-btn" id="btn-${c.id}" onclick="toggleSelect(${c.id})">Select</button>`}
      </div>
    </div>
  `).join("");

  updateCounter();
  updateSelectionUI();
}

function toggleSelect(id) {
  if (revealedSet.has(id)) return;
  if (selectedIds.has(id)) {
    selectedIds.delete(id);
  } else {
    if (selectedIds.size >= BATCH_SIZE) {
      alert(`You can only select ${BATCH_SIZE} numbers at a time.`);
      return;
    }
    selectedIds.add(id);
  }
  updateSelectionUI();
}

function updateSelectionUI() {
  document.querySelectorAll("[id^='btn-']").forEach(btn => {
    const id = parseInt(btn.id.replace("btn-", ""));
    if (selectedIds.has(id)) {
      btn.textContent = "✓ Selected";
      btn.style.background = "#5C1717";
      btn.style.color = "#E8C166";
    } else {
      btn.textContent = "Select";
      btn.style.background = "#C99A3A";
      btn.style.color = "#1C0F0A";
    }
  });

  if (selectedIds.size > 0) {
    document.getElementById("status").innerHTML =
      `Selected ${selectedIds.size}/${BATCH_SIZE} — 
       <button onclick="revealSelected()" style="padding:6px 14px;font-size:0.85rem;margin-left:8px">
         Reveal ${selectedIds.size}
       </button>`;
  } else {
    document.getElementById("status").textContent = "";
  }
}

async function revealSelected() {
  if (!sessionId || needsCaptcha) {
    showCaptcha();
    return;
  }
  if (selectedIds.size === 0) return;

  const ids = Array.from(selectedIds);
  const res = await fetch(`${FN_URL}/get-contact`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ contact_ids: ids, session_id: sessionId }),
  });
  const data = await res.json();

  if (res.status === 428) {
    needsCaptcha = true;
    sessionId = null;
    selectedIds.clear();
    showCaptcha();
    document.getElementById("status").textContent =
      "🔒 View limit reached. Please complete captcha again.";
    return;
  }

  if (data.error) {
    document.getElementById("status").textContent = "⚠️ " + data.error;
    return;
  }

  data.contacts.forEach(c => {
    revealedSet.add(c.id);
    const el = document.getElementById(`phone-${c.id}`);
    if (el) el.textContent = "+91 " + c.phone;
  });

  viewsRemaining = data.views_remaining;
  selectedIds.clear();
  render();

  if (viewsRemaining <= 0) {
    needsCaptcha = true;
    sessionId = null;
    showCaptcha();
    document.getElementById("status").textContent =
      "🔒 Session views used. Please verify again.";
  }
}

function updateCounter() {
  const counter = document.getElementById("counter");
  counter.style.display = "block";
  counter.textContent =
    `📊 Revealed: ${revealedSet.size} · Views remaining before next captcha: ${viewsRemaining}`;
}

function showCaptcha() {
  document.getElementById("captchaBox").style.display = "block";
}

async function onCaptchaSuccess(token) {
  document.getElementById("status").textContent = "Verifying...";
  const res = await fetch(`${FN_URL}/verify-captcha`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ token }),
  });
  const data = await res.json();

  if (data.session_id) {
    sessionId = data.session_id;
    viewsRemaining = data.views_before_recaptcha;
    needsCaptcha = false;
    document.getElementById("captchaBox").style.display = "none";
    document.getElementById("status").textContent =
      "✅ Verified. Select up to 5 numbers, then click Reveal.";
    updateCounter();
  } else {
    document.getElementById("status").textContent = "⚠️ " + (data.error || "Verification failed");
  }
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}

loadList();
</script>
</body>
</html>
